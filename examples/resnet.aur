# A compact residual classifier with explicit skip connections.
experiment CIFAR10_ResNet:
    seed = 42
    device = "auto"

dataset cifar_train:
    from torchvision.datasets.CIFAR10
    root = "./data/cifar10"
    train = True
    download = True
    batch = 128

dataset cifar_val:
    from torchvision.datasets.CIFAR10
    root = "./data/cifar10"
    train = False
    download = True
    batch = 256

model ResNetBlock:
    input_shape = (16, 32, 32)
    def forward(x):
        hidden = conv2d(x, 16, kernel=3, padding=1).relu
        hidden = conv2d(hidden, 16, kernel=3, padding=1)
        output = add(x, hidden).relu
        return output

model ResNetClassifier:
    input_shape = (3, 32, 32)
    def forward(x):
        stem = conv2d(x, 16, kernel=3, padding=1).relu
        hidden = conv2d(stem, 16, kernel=3, padding=1).relu
        hidden = conv2d(hidden, 16, kernel=3, padding=1)
        residual = add(stem, hidden).relu
        pooled = global_avg_pool(residual)
        output = dense(pooled, 10)
        return output

train ResNetClassifier on cifar_train:
    validate_on = cifar_val
    loss = cross_entropy
    optimizer = adam(lr=0.001, weight_decay=0.0001)
    epochs = 50
    metrics = [accuracy, top5_accuracy]
    scheduler = cosine_annealing(T_max=50, eta_min=0.000001)
    early_stopping = True
    patience = 10
    save_best = True
    checkpoint_dir = "./checkpoints/resnet"
