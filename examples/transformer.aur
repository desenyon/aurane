# Offline next-token training on synthetic data. This is a wiring example,
# not a language-quality benchmark. Replace the source for real text training.
experiment TransformerDemo:
    seed = 42
    device = "cpu"

vocabulary = 64
width = 32

dataset token_train:
    from aurane.data.SyntheticTokens
    size = 64
    sequence_length = 16
    vocab_size = vocabulary
    seed = 42
    batch = 8

dataset token_val:
    from aurane.data.SyntheticTokens
    size = 16
    sequence_length = 16
    vocab_size = vocabulary
    seed = 43
    batch = 8
    shuffle = False

model LanguageModel:
    input_shape = (16,)
    def forward(tokens):
        tokens -> embedding(vocabulary, width)
               -> positional_encoding(max_len=32)
               -> multihead_attention(heads=4, dim=width, causal=True).residual
               -> layer_norm()
               -> dense(64).gelu
               -> dense(width)
               -> layer_norm()
               -> dense(vocabulary)

train LanguageModel on token_train:
    validate_on = token_val
    loss = cross_entropy
    optimizer = adamw(lr=0.001)
    epochs = 2
    metrics = [perplexity, accuracy]
    scheduler = warmup_cosine(warmup_steps=2, max_steps=16)
    gradient_clip = 1.0
